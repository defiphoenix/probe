rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /evaluations/{evaluationId} {
      allow read: if true;
      allow create: if isValidEvaluation(request.resource.data);
      allow update: if isValidEvaluation(request.resource.data) && (request.resource.data.attempts > resource.data.attempts);
    }

    function isValidEvaluation(data) {
      return data.projectName is string && 
             data.projectName.size() < 100 &&
             data.totalScore is number &&
             data.totalScore >= 0 &&
             data.totalScore <= 100 &&
             data.type in ["RAPID", "AUDIT"] &&
             data.verdict is string &&
             data.attempts is number;
    }
  }
}
